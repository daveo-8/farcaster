# Monorepo .gitignore for Horsey (Foundry + Ponder)

# ============================================
# Node.js
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.npm
.yarn-integrity

# ============================================
# Foundry (horsey-foundry/)
# ============================================
# Build artifacts
horsey-foundry/out/
horsey-foundry/cache/
horsey-foundry/.gas-snapshot

# Broadcast files (deployment artifacts)
# Ignore local Anvil (31337) timestamped runs, but keep run-latest.json for Ponder
horsey-foundry/broadcast/Deploy.s.sol/31337/run-[0-9]*.json
# Ignore all script broadcast files (Bet, ResolveRace, Claim)
horsey-foundry/broadcast/Bet.s.sol/
horsey-foundry/broadcast/ResolveRace.s.sol/
horsey-foundry/broadcast/Claim.s.sol/

# Generated files
horsey-foundry/generated/

# ============================================
# Ponder (horsey-ponder/)
# ============================================
# Ponder cache and build
horsey-ponder/.ponder/
horsey-ponder/generated/

# Database files (if using SQLite)
horsey-ponder/*.db
horsey-ponder/*.db-*

# Ponder environment
horsey-ponder/.env.local
horsey-ponder/.env

# Generated ABIs (auto-generated by Wagmi)
# Keep these committed for easy setup
# horsey-ponder/abis/

# ============================================
# Environment & Secrets
# ============================================
.env
.env.local
.env.*.local
*.key
*.secret

# ============================================
# IDE & Editors
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude Code
.claude/

# ============================================
# TypeScript
# ============================================
*.tsbuildinfo
dist/
build/

# ============================================
# Logs
# ============================================
*.log
logs/

# ============================================
# OS
# ============================================
.DS_Store
Thumbs.db

# ============================================
# Temporary files
# ============================================
*.tmp
*.temp
.cache/
